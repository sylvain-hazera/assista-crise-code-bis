<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Position : lue quand la carte est ouverte, et suivie en mission SEULEMENT, par le
         service de terrain, visible en permanence. Depuis le 22/11/2026, le suivi demarre aussi
         application fermee quand l'equipe est engagee : d'ou la permission d'arriere-plan,
         demandee avec l'explication du dossier § 6, et la coupure a la liberation. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- La liaison avec la radio Meshtastic ou MeshCore reste ouverte en arriere-plan. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Reprise au redemarrage du telephone, si une mission ou une radio etait active. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Demande, expliquee, de ne pas etre mis en sommeil : sans elle, Android peut refuser de
         demarrer le suivi quand l'equipe est engagee application fermee. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Camera : uniquement pour lire un QR code de mobilisation, image par image, sans rien
         enregistrer. Les photos, elles, restent confiees a l'appareil photo du telephone. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Bluetooth : pour parler a la radio de l'intervenant. Jamais pour le localiser, et
         l'application reste utilisable sur un telephone qui n'en a pas. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- allowBackup="false" : la session et le cache sont chiffres par une cle du Keystore,
         qui ne quitte pas le telephone. Une sauvegarde restauree ailleurs serait illisible,
         et l'en exclure evite surtout de faire voyager des donnees de mission. -->
    <!-- Pour demander une photo a l'appareil photo du telephone. L'application ne declare pas
         la permission CAMERA : elle ne filme ni ne photographie jamais elle-meme. -->
    <queries>
        <intent><action android:name="android.media.action.IMAGE_CAPTURE" /></intent>
    </queries>

    <application
        android:name=".Application"
        android:networkSecurityConfig="@xml/securite_reseau"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/nom_application"
        android:supportsRtl="true"
        android:theme="@style/Theme.Application">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Un QR code de mobilisation lu par l'appareil photo du telephone contient une
                 adresse du site : l'application se propose pour l'ouvrir et rendre le verdict. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="${hoteSite}" />
                <!-- Les attestations portent le domaine public du serveur, qui n'est pas
                     toujours celui de la marque. -->
                <data android:host="assista-crise.fr" />
                <data android:host="www.assista-crise.fr" />
                <data android:pathPrefix="/verifier-mobilisation/" />
                <data android:pathPrefix="/api/verifier-mobilisation/" />
            </intent-filter>
        </activity>
        <!-- Prete a l'appareil photo, le temps d'une prise, l'adresse d'un fichier du cache. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.prises"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/chemins_prises" />
        </provider>
        <service
            android:name=".ServiceTerrain"
            android:exported="false"
            android:foregroundServiceType="location|connectedDevice" />
        <receiver
            android:name=".DemarrageTelephone"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
