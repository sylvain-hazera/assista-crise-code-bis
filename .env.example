# Modèle de .env (jamais commité) — ./scripts/init-secrets.sh le crée et le complète.

# --- Base de données. Sur une base NEUVE, DB_USER devient le superuser PostgreSQL.
DB_USER=admin
DB_PASS=change-me

# --- Django. SECRET_KEY obligatoire (sauf DEBUG=True ou tests).
SECRET_KEY=change-me
EMAIL_PASSWORD=change-me
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# --- Active les services de monitoring à chaque commande docker compose
COMPOSE_PROFILES=monitoring

# --- Production : dossier des secrets sur la VM (défaut : ./secrets)
# SECRETS_DIR=/etc/assista-crise/secrets

# --- Pont MeshCore de test (docker compose --profile meshcore-test up)
# MESHCORE_BRIDGE_EMAIL=
# MESHCORE_BRIDGE_PASSWORD=
# MESHCORE_COMPAGNON_ID=
# MESHCORE_TCP_HOST=

# --- Machine avec l'antenne LoRa uniquement
# COMPOSE_FILE=docker-compose.yml:docker-compose.override.yml:docker-compose.antenna.yml
