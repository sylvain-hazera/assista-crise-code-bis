    {
      "type": "table",
      "title": "IP les plus bannies",
      "description": "",
      "id": 7,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "topk(20, sum by (ip, jail) (count_over_time({job=\"fail2ban\", event=\"Ban\"} | json ip=\"ip\" [$__range])))",
          "queryType": "instant",
          "legendFormat": "",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
