              "jail": 1,
              "Value": 2
            },
            "renameByName": {
              "ip": "Adresse IP",
              "jail": "Jail",
              "Value": "Nombre"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Nombre",
            "desc": true
