{
  "uid": "assista-overview",
  "title": "Assista-Crise Overview",
  "tags": [
    "assista-crise"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
