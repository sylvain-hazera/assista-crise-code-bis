FROM python:3.12-slim

# Binaire Go statique (aucune dépendance runtime) — voir
# https://github.com/protomaps/go-pmtiles/releases. Assets vérifiés le 2026-09-17 :
# go-pmtiles_<version>_Linux_arm64.tar.gz (Raspberry Pi) / _x86_64.tar.gz (le reste).
ARG PMTILES_VERSION=1.31.2
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && ARCH=$( [ "$TARGETARCH" = "amd64" ] && echo x86_64 || echo arm64 ) \
    && curl -sL "https://github.com/protomaps/go-pmtiles/releases/download/v${PMTILES_VERSION}/go-pmtiles_${PMTILES_VERSION}_Linux_${ARCH}.tar.gz" \
       | tar -xz -C /usr/local/bin pmtiles \
    && pmtiles version

WORKDIR /app
COPY telecharger_tuiles.py .
COPY data/ data/

ENTRYPOINT ["python", "-u", "telecharger_tuiles.py"]
