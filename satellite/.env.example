# Copier en .env et compléter avant `docker compose --profile gw up -d` (ou --profile full).

# --- Central ---
CENTRAL_URL=https://assista-crise.fr
# Compte de service du satellite — obtenu via SatelliteViewSet.valider (Django admin / vue
# Satellites), affiché UNE SEULE FOIS à la validation, jamais relisible ensuite.
SATELLITE_EMAIL=
SATELLITE_PASSWORD=

# --- Nœud MeshCore ---
# SERIE (nœud branché en USB sur ce Raspberry Pi) ou TCP (nœud sur le LAN, IP/port séparés).
MESHCORE_CONNEXION_TYPE=SERIE
MESHCORE_SERIE_DEVICE=/dev/ttyUSB0
MESHCORE_TCP_HOST=
MESHCORE_TCP_PORT=5000
MESHCORE_PROXY_PORT=5050
# UUID du CompagnonMeshCore déjà créé côté central pour ce satellite (voir Django admin ou
# POST /api/compagnons-meshcore/).
MESHCORE_COMPAGNON_ID=
# Nom affiché dans l'annonce mDNS du proxy (voir meshcore-bridge/README.md).
SATELLITE_NOM=satellite-1

# --- Profil "full" uniquement : instance assista-crise locale ---
SECRET_KEY=
DB_USER=assista_app
DB_PASS=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
# Découpage cartographique offline : département principal du satellite (voir
# telecharger_tuiles.py — les départements limitrophes sont ajoutés automatiquement) et URL du
# build PMTiles du jour (https://maps.protomaps.com/builds, se périme, pas de "latest" stable).
SATELLITE_DEPARTEMENT=38
PMTILES_SOURCE=

LOG_LEVEL=INFO
